<!doctype html>
<html lang="pt-BR">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Vagas PJ</title></head>
<body style="margin:0;padding:16px;font-family:Arial,Helvetica,sans-serif;background:#f4f5f7;color:#1f2328;">
  <h1 style="font-size:20px;margin:0 0 8px;">Vagas PJ — {{ stats.started_at.strftime('%d/%m/%Y') }}</h1>
  <p style="font-size:13px;color:#57606a;margin:0 0 16px;">
    Coletadas: {{ stats.collected }} · Após filtros: {{ stats.after_filters }} ·
    Avaliadas pelo LLM: {{ stats.sent_to_llm }} · Enviadas: {{ stats.emailed }}
  </p>
  {% if not ranked %}
  <p style="font-size:14px;">Nenhuma vaga nova.</p>
  {% endif %}
  {% for item in ranked %}
  {% set job = item.job %}
  <div style="background:#ffffff;border-radius:8px;padding:12px;margin:0 0 12px;">
    <span style="display:inline-block;font-size:13px;font-weight:bold;color:#ffffff;background:#0969da;border-radius:12px;padding:2px 10px;">{{ item.total }}%</span>
    {% if item.is_estimate %}<span style="font-size:12px;color:#9a6700;">estimativa</span>{% endif %}
    <div style="margin-top:6px;"><a href="{{ job.url }}" style="font-size:16px;font-weight:bold;color:#0969da;text-decoration:none;">{{ job.title }}</a></div>
    <div style="font-size:13px;color:#57606a;">{{ job.company }}{% if job.location %} · {{ job.location }}{% endif %}{% if job.publisher %} · {{ job.publisher }}{% endif %}</div>
  </div>
  {% endfor %}
</body>
</html>
